<Window x:Class="pr_25.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr_25"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🕒" FontSize="32" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="DodgerBlue"/>
            <TextBlock Text="Умная напоминалка" FontSize="28" FontWeight="Bold"  Foreground="DodgerBlue" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid x:Name="RemindersGrid" 
                  Grid.Row="1"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  Margin="0,10,0,10"
                  AlternatingRowBackground="#E3F2FD"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Часы" Binding="{Binding Hour}" Width="70"/>
                <DataGridTextColumn Header="Минуты" Binding="{Binding Minute}" Width="70"/>
                <DataGridTextColumn Header="Текст" Binding="{Binding Text}" Width="*"/>
                <DataGridCheckBoxColumn Header="Показано" Binding="{Binding IsShown}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,15">
            <TextBox x:Name="txtHour" Width="50" Margin="5" Padding="3" ToolTip="Часы"/>
            <TextBox x:Name="txtMinute" Width="50" Margin="5" Padding="3" ToolTip="Минуты"/>
            <TextBox x:Name="txtText" Width="250" Margin="5" Padding="3" ToolTip="Текст напоминания"/>
            <Button Content="Добавить" Width="100" Margin="5" Click="Add_Click" Background="SeaGreen" Foreground="White" FontWeight="Bold" FontSize="13"/>
        </StackPanel>

     
        <UniformGrid Columns="3" Grid.Row="3" Width="450" HorizontalAlignment="Center">
            <Button Content="📁 Открыть" Margin="5" Padding="8" Click="Open_Click" Background="DodgerBlue" Foreground="White" FontSize="13"/>
            <Button Content="💾 Сохранить" Margin="5" Padding="8" Click="Save_Click" Background="#1E88E5" Foreground="White" FontSize="13"/>
            <Button Content="❌ Удалить" Margin="5" Padding="8" Click="Delete_Click" Background="Red" Foreground="White" FontSize="13"/>
        </UniformGrid>
    </Grid>
</Window>
